# Save real secrets in /opt/sportsmatch/.env; never commit real tokens
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
APISPORTS_KEY=REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
DATABASE_PATH=/opt/sportsmatch/data/matches.sqlite3
API_DAILY_LIMIT=90
ENABLE_POLLER=true
# Exact origin for the self-hosted browser UI (scheme + host, no trailing slash).
# Sites Worker proxy requests omit the browser Origin header and do not need this.
PUBLIC_ORIGIN=https://sportsmatch.sendmymail.top
